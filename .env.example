# 复制为 .env 后填入真实值；.env 不入库

# 开发库（docker compose -f docker-compose.dev.yml up -d 后可用）
DATABASE_URL="postgresql://postgres:devpass@localhost:5433/pmm?schema=public"
# 测试库，必须与开发库分离，测试会清空数据
TEST_DATABASE_URL="postgresql://postgres:devpass@localhost:5433/pmm_test?schema=public"

# Auth.js 会话签名密钥，生产环境用 openssl rand -base64 32 生成
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# 公开页绝对地址，用于 OG 图与分享链接
PUBLIC_BASE_URL="http://localhost:3000"

# 首个管理员账号，由 pnpm db:seed 创建
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
