{$DOMAIN} {
	encode zstd gzip

	# 上传目录直接静态服务：file_server 自带 Range(206)/ETag，视频可拖动进度条。
	# 走 Next.js Route Handler 需要手写 Range 解析，还会阻塞 Node 单线程。
	handle_path /media/* {
		root * /srv/data/uploads
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle {
		reverse_proxy app:3000
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
